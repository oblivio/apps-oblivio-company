{
  "slug": "game_portal",
  "name": "Game Portal",
  "description": "Multiplayer game portal supporting Dominoes with WebSocket real-time gameplay",
  "status": "active",
  "auth_required": false,
  "data_scope": ["self"],
  "managed_indexes": {
    "games": [
      {
        "name": "games_status_index",
        "type": "regular",
        "keys": { "status": 1 }
      },
      {
        "name": "games_created_at_index",
        "type": "regular",
        "keys": { "created_at": -1 }
      },
      {
        "name": "games_game_type_status_index",
        "type": "regular",
        "keys": { "game_type": 1, "status": 1 }
      },
      {
        "name": "games_host_id_index",
        "type": "regular",
        "keys": { "host_id": 1 },
        "options": { "sparse": true }
      }
    ]
  }
}

